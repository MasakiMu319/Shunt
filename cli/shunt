def cmd_snapshot(rpc, args):
    """Get AX tree via CDP, output compact format with [ref=eN]"""
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Accessibility.getFullAXTree",
        "params": {"depth": args.depth},
    })
    nodes = result.get("result", {}).get("nodes", [])
    if not nodes:
        print("(empty)")
        return

    node_map = {}
    roots = []
    for n in nodes:
        node_map[n["nodeId"]] = n
        if not n.get("parentId"):
            roots.append(n)

    def walk(node, depth):
        # Walk children even if node is ignored (just don't print it)
        indent = "  " * min(depth, 8)
        if not node.get("ignored"):
            role = node.get("role", {}).get("value", "?")
            name = node.get("name", {}).get("value", "")
            ref = f" [ref=e{node['backendDOMNodeId']}]" if node.get("backendDOMNodeId") else ""
            name_str = f" \"{name[:80]}\"" if name else ""
            print(f"{indent}{role}{name_str}{ref}")
        for cid in node.get("childIds", []):
            child = node_map.get(cid)
            if child:
                walk(child, depth + 1)

    for root in roots:
        walk(root, 0)

def cmd_click_ref(rpc, args):
    """Click element by backend node ID via JS dispatch (bypasses Helium Input bug)"""
    # Step 1: scroll into view
    _ = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "DOM.scrollIntoViewIfNeeded",
        "params": {"backendNodeId": args.node_id},
    })

    # Step 2: get content quads
    quads_res = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "DOM.getContentQuads",
        "params": {"backendNodeId": args.node_id},
    })
    quads = quads_res.get("result", {}).get("quads", [])
    if quads:
        q = quads[0]
        x = round((q[0] + q[4]) / 2)
        y = round((q[1] + q[5]) / 2)
    else:
        # Fallback: resolveNode → getBoxModel
        resolve = rpc.call("executeCdp", {
            "tabId": args.tab_id,
            "method": "DOM.resolveNode",
            "params": {"backendNodeId": args.node_id},
        })
        obj_id = resolve.get("result", {}).get("object", {}).get("objectId")
        if not obj_id:
            print("Error: could not resolve node", file=sys.stderr)
            sys.exit(1)
        box = rpc.call("executeCdp", {
            "tabId": args.tab_id,
            "method": "DOM.getBoxModel",
            "params": {"objectId": obj_id},
        })
        quad = box.get("result", {}).get("model", {}).get("content")
        if not quad or len(quad) < 8:
            print("Error: no box model", file=sys.stderr)
            sys.exit(1)
        x = round((quad[0] + quad[4]) / 2)
        y = round((quad[1] + quad[5]) / 2)

    # Step 3: click via JS (CDP Input.dispatchMouseEvent doesn't generate DOM events in Helium)
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const el = document.elementFromPoint({x}, {y});
                if (!el) return 'no-element';
                ['mousedown','mouseup','click','pointerdown','pointerup'].forEach(t => {{
                    el.dispatchEvent(new MouseEvent(t, {{ bubbles: true, cancelable: true, clientX: {x}, clientY: {y}, button: 0 }}));
                }});
                return 'clicked:' + el.tagName;
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["x"] = x
    result["y"] = y
    print(json.dumps(result))

