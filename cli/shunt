def cmd_snapshot(rpc, args):
    """Get AX tree via CDP, output compact format with [ref=eN]"""
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Accessibility.getFullAXTree",
        "params": {"depth": args.depth},
    })
    nodes = result.get("result", {}).get("nodes", [])
    if not nodes:
        print("(empty)")
        return

    node_map = {}
    roots = []
    for n in nodes:
        node_map[n["nodeId"]] = n
        if not n.get("parentId"):
            roots.append(n)

    def walk(node, depth):
        # Walk children even if node is ignored (just don't print it)
        indent = "  " * min(depth, 8)
        if not node.get("ignored"):
            role = node.get("role", {}).get("value", "?")
            name = node.get("name", {}).get("value", "")
            ref = f" [ref=e{node['backendDOMNodeId']}]" if node.get("backendDOMNodeId") else ""
            name_str = f" \"{name[:80]}\"" if name else ""
            print(f"{indent}{role}{name_str}{ref}")
        for cid in node.get("childIds", []):
            child = node_map.get(cid)
            if child:
                walk(child, depth + 1)

    for root in roots:
        walk(root, 0)

def cmd_click_ref(rpc, args):
    """Click element by backend node ID via JS dispatch (bypasses Helium Input bug)"""
    # Step 1: scroll into view
    _ = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "DOM.scrollIntoViewIfNeeded",
        "params": {"backendNodeId": args.node_id},
    })

    # Step 2: get content quads
    quads_res = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "DOM.getContentQuads",
        "params": {"backendNodeId": args.node_id},
    })
    quads = quads_res.get("result", {}).get("quads", [])
    if quads:
        q = quads[0]
        x = round((q[0] + q[4]) / 2)
        y = round((q[1] + q[5]) / 2)
    else:
        # Fallback: resolveNode → getBoxModel
        resolve = rpc.call("executeCdp", {
            "tabId": args.tab_id,
            "method": "DOM.resolveNode",
            "params": {"backendNodeId": args.node_id},
        })
        obj_id = resolve.get("result", {}).get("object", {}).get("objectId")
        if not obj_id:
            print("Error: could not resolve node", file=sys.stderr)
            sys.exit(1)
        box = rpc.call("executeCdp", {
            "tabId": args.tab_id,
            "method": "DOM.getBoxModel",
            "params": {"objectId": obj_id},
        })
        quad = box.get("result", {}).get("model", {}).get("content")
        if not quad or len(quad) < 8:
            print("Error: no box model", file=sys.stderr)
            sys.exit(1)
        x = round((quad[0] + quad[4]) / 2)
        y = round((quad[1] + quad[5]) / 2)

    # Step 3: click via JS (CDP Input.dispatchMouseEvent doesn't generate DOM events in Helium)
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const el = document.elementFromPoint({x}, {y});
                if (!el) return 'no-element';
                ['mousedown','mouseup','click','pointerdown','pointerup'].forEach(t => {{
                    el.dispatchEvent(new MouseEvent(t, {{ bubbles: true, cancelable: true, clientX: {x}, clientY: {y}, button: 0 }}));
                }});
                return 'clicked:' + el.tagName;
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["x"] = x
    result["y"] = y
    print(json.dumps(result))

def cmd_finalize(rpc, args):
    keep = args.tab_ids if args.tab_ids else []
    result = rpc.call("finalizeTabs", {"keep": keep})
    print(json.dumps(result))

def cmd_wait_for(rpc, args):
    try:
        result = rpc.wait_for_event(args.tab_id, args.event, timeout=args.timeout)
        print(json.dumps(result))
    except (TimeoutError, ConnectionError) as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)


# ── Main ──

def main():
    parser = argparse.ArgumentParser(prog="shunt", description="Browser automation via Helium Extension")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("create-tab", help="Create a new background tab")
    p.set_defaults(func=cmd_create_tab)

    p = sub.add_parser("close-tab", help="Close a tab (detaches debugger if attached)")
    p.add_argument("tab_id", type=int)
    p.set_defaults(func=cmd_close_tab)

    p = sub.add_parser("attach", help="Attach debugger to a tab (enables Page, Network, Runtime domains)")
    p.add_argument("tab_id", type=int)
    p.set_defaults(func=cmd_attach)

    p = sub.add_parser("detach", help="Detach debugger from a tab")
    p.add_argument("tab_id", type=int)
    p.set_defaults(func=cmd_detach)

    p = sub.add_parser("cdp", help="Execute a CDP command on an attached tab")
    p.add_argument("tab_id", type=int)
    p.add_argument("method")
    p.add_argument("params", nargs="?", help="JSON params string")
    p.set_defaults(func=cmd_cdp)

    p = sub.add_parser("screenshot", help="Capture screenshot (base64 PNG to stdout)")
    p.add_argument("tab_id", type=int)
    p.add_argument("--format", choices=["png", "jpeg"], default="png")
    p.add_argument("--quality", type=int, default=None)
    p.add_argument("--clip", type=json.loads, default=None, help='JSON clip rect {"x":0,"y":0,"width":100,"height":100,"scale":1}')
    p.set_defaults(func=cmd_screenshot)

    p = sub.add_parser("click", help="Click at coordinates")
    p.add_argument("tab_id", type=int)
    p.add_argument("x", type=int)
    p.add_argument("y", type=int)
    p.set_defaults(func=cmd_click)

    p = sub.add_parser("type", help="Type text via CDP Input.dispatchKeyEvent")
    p.add_argument("tab_id", type=int)
    p.add_argument("text")
    p.set_defaults(func=cmd_type)

    p = sub.add_parser("scroll", help="Scroll by delta (default: 500px down)")
    p.add_argument("tab_id", type=int)
    p.add_argument("--x", type=int, default=0)
    p.add_argument("--y", type=int, default=0)
    p.add_argument("--dx", type=int, default=0)
    p.add_argument("--dy", type=int, default=500)
    p.set_defaults(func=cmd_scroll)

    p = sub.add_parser("user-tabs", help="List all user tabs")
    p.set_defaults(func=cmd_user_tabs)

    p = sub.add_parser("activate", help="Activate/focus a tab")
    p.add_argument("tab_id", type=int)
    p.set_defaults(func=cmd_activate)


    p = sub.add_parser("session", help="Show current session state")
    p.set_defaults(func=cmd_session)

    p = sub.add_parser("find-element", help="Find DOM element by text or CSS selector")
    p.add_argument("tab_id", type=int)
    p.add_argument("--text", help="Text content to search for (partial match)")
    p.add_argument("--selector", help="CSS selector")
    p.set_defaults(func=cmd_find_element)

    p = sub.add_parser("get-text", help="Extract visible page text")
    p.add_argument("tab_id", type=int)
    p.add_argument("--max-length", type=int, default=10000)
    p.set_defaults(func=cmd_get_text)

    p = sub.add_parser("snapshot", help="Get accessibility tree snapshot with [ref=eN]")
    p.add_argument("tab_id", type=int)
    p.add_argument("-d", "--depth", type=int, default=4, help="Max tree depth (default 4)")
    p.set_defaults(func=cmd_snapshot)

    p = sub.add_parser("click-ref", help="Click element by backend node ID (from snapshot ref)")
    p.add_argument("tab_id", type=int)
    p.add_argument("node_id", type=int, help="Backend DOM node ID (e.g. e123)")
    p.set_defaults(func=cmd_click_ref)

    p = sub.add_parser("finalize", help="Close all agent tabs except the ones specified")


    p.add_argument("tab_ids", nargs="*", type=int, help="Tab IDs to keep")
    p.set_defaults(func=cmd_finalize)

    p = sub.add_parser("wait-for", help="Wait for a CDP event on a tab")
    p.add_argument("tab_id", type=int)
    p.add_argument("event", help="CDP event method (e.g. Page.loadEventFired)")
    p.add_argument("--timeout", type=int, default=30)
    p.set_defaults(func=cmd_wait_for)

    args = parser.parse_args()
    rpc = ShuntRPC()
    try:
        args.func(rpc, args)
    except RuntimeError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except ConnectionRefusedError:
        print("Error: Can't connect to shunt-host. Is the Extension loaded and running?", file=sys.stderr)
        sys.exit(1)
    finally:
        rpc._close()

if __name__ == "__main__":
    main()
