def cmd_drag(rpc, args):
    """Drag along a path via JS dispatch (CDP Input.dispatchMouseEvent broken in Helium)"""
    path = args.path  # list of (x,y) tuples, e.g. [(100,200),(300,200)]
    pts_json = json.dumps(path)
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const path = {pts_json};
                if (path.length < 2) return 'drag-needs-2+points';
                let el = document.elementFromPoint(path[0][0], path[0][1]);
                if (!el) return 'no-element-at-start';
                const opts = (x,y,buttons) => ({{
                    bubbles: true, cancelable: true, clientX: x, clientY: y,
                    button: 0, buttons: buttons, view: window
                }});
                el.dispatchEvent(new MouseEvent('pointerdown', opts(path[0][0], path[0][1], 1)));
                el.dispatchEvent(new MouseEvent('mousedown', opts(path[0][0], path[0][1], 1)));
                for (let i = 1; i < path.length - 1; i++) {{
                    el = document.elementFromPoint(path[i][0], path[i][1]);
                    if (el) {{
                        el.dispatchEvent(new MouseEvent('pointermove', opts(path[i][0], path[i][1], 1)));
                        el.dispatchEvent(new MouseEvent('mousemove', opts(path[i][0], path[i][1], 1)));
                    }}
                }}
                const last = path[path.length - 1];
                el = document.elementFromPoint(last[0], last[1]);
                if (el) {{
                    el.dispatchEvent(new MouseEvent('pointermove', opts(last[0], last[1], 1)));
                    el.dispatchEvent(new MouseEvent('mousemove', opts(last[0], last[1], 1)));
                    el.dispatchEvent(new MouseEvent('pointerup', opts(last[0], last[1], 0)));
                    el.dispatchEvent(new MouseEvent('mouseup', opts(last[0], last[1], 0)));
                }}
                return 'dragged:' + path.length + 'pts';
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["path"] = path
    print(json.dumps(result))


def cmd_download_media(rpc, args):
    """Extract and trigger download of media at coordinates via JS fetch→blob→click"""
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const el = document.elementFromPoint({args.x}, {args.y});
                if (!el) return JSON.stringify({{ error: 'no-element' }});
                const media = el.closest?.('img, video, audio, source, a[href]') ?? el;
                const url = media.currentSrc ?? media.src ?? media.href ?? '';
                if (!url) return JSON.stringify({{ error: 'no-media-url', tag: media.tagName }});
                fetch(url)
                    .then(r => r.blob())
                    .then(blob => {{
                        const a = document.createElement('a');
                        a.href = URL.createObjectURL(blob);
                        a.download = url.split('/').pop().split('?')[0] || 'download';
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(() => {{ document.body.removeChild(a); URL.revokeObjectURL(a.href); }}, 5000);
                    }})
                    .catch(e => console.error('download error:', e));
                return JSON.stringify({{ url: url, tag: media.tagName }});
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["x"] = args.x
    result["y"] = args.y
    print(json.dumps(result))


def cmd_history(rpc, args):
    """Navigate history via JS (CDP Page.navigateToHistoryEntry unreliable in Helium)"""
    if args.direction == "back":
        expr = "history.back(); setTimeout(() => {}, 100); 'back-ok'"
    elif args.direction == "forward":
        expr = "history.forward(); setTimeout(() => {}, 100); 'forward-ok'"
    elif args.direction == "goto":
        expr = f"history.go({args.index}); setTimeout(() => {{}}, 100); 'goto-ok'"
    else:
        expr = f"JSON.stringify({{length:history.length,current:{args.tab_id}}})"
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {"expression": expr, "returnByValue": True},
    })
    result["direction"] = args.direction
    print(json.dumps(result))


