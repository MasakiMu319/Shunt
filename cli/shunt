def cmd_click(rpc, args):
    """Click at viewport coordinates via JS dispatch (CDP Input.dispatchMouseEvent broken in Helium)"""
    double = getattr(args, 'double', False)
    events = ['mousedown','mouseup','click','pointerdown','pointerup']
    if double:
        events += ['dblclick', 'mousedown','mouseup','click','pointerdown','pointerup']
    events_str = ','.join(f"'{e}'" for e in events)
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const el = document.elementFromPoint({args.x}, {args.y});
                if (!el) return 'no-element at ({args.x},{args.y})';
                [{events_str}].forEach(t => {{
                    el.dispatchEvent(new MouseEvent(t, {{ bubbles: true, cancelable: true, clientX: {args.x}, clientY: {args.y}, button: 0, detail: t === 'dblclick' ? 2 : 1 }}));
                }});
                return {("'double-clicked:'" if double else "'clicked:'")} + el.tagName;
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["x"] = args.x
    result["y"] = args.y
    print(json.dumps(result))

def cmd_type(rpc, args):
    """Type text via JS dispatch (CDP Input.dispatchKeyEvent broken in Helium)"""
    escaped = args.text.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n")
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const text = '{escaped}';
                const el = document.activeElement;
                if (!el) return 'no-active-element';
                const tag = el.tagName.toLowerCase();
                if (tag === 'input' || tag === 'textarea') {{
                    const start = el.selectionStart ?? el.value.length;
                    el.value = el.value.slice(0, start) + text + el.value.slice(el.selectionEnd ?? start);
                    el.selectionStart = el.selectionEnd = start + text.length;
                    el.dispatchEvent(new Event('input', {{ bubbles: true }}));
                    el.dispatchEvent(new Event('change', {{ bubbles: true }}));
                    return 'typed:' + tag;
                }}
                if (el.isContentEditable) {{
                    // execCommand triggers React re-render → double insert.
                    // Instead: write to the text node directly, then dispatch input.
                    const sel = window.getSelection();
                    if (sel.rangeCount) {{
                        const range = sel.getRangeAt(0);
                        range.deleteContents();
                        range.insertNode(document.createTextNode(text));
                        // Collapse after inserted node
                        range.collapse(false);
                        sel.removeAllRanges();
                        sel.addRange(range);
                    }} else {{
                        // No selection: append
                        el.appendChild(document.createTextNode(text));
                    }}
                    el.dispatchEvent(new Event('input', {{ bubbles: true }}));
                    el.dispatchEvent(new Event('change', {{ bubbles: true }}));
                    return 'typed:contenteditable';
                }}
                return 'typed:unknown-' + tag;
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["text"] = args.text
    print(json.dumps(result))

# KeyCode mapping for common keys
KEY_CODES = {
    "Enter": 13, "Tab": 9, "Escape": 27, "Backspace": 8, "Delete": 46, "Space": 32,
    "ArrowUp": 38, "ArrowDown": 40, "ArrowLeft": 37, "ArrowRight": 39,
    "Home": 36, "End": 35, "PageUp": 33, "PageDown": 34,
}

def cmd_keypress(rpc, args):
    """Dispatch key press via JS (CDP Input.dispatchKeyEvent broken in Helium)"""
    key = args.key
    key_code = KEY_CODES.get(key, 0)
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const el = document.activeElement || document.body;
                const opts = {{ key: '{key}', code: '{key}', keyCode: {key_code},
                    which: {key_code}, bubbles: true, cancelable: true, composed: true }};
                ['keydown','keypress','keyup'].forEach(t => {{
                    el.dispatchEvent(new KeyboardEvent(t, opts));
                }});
                return 'pressed:' + '{key}';
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["key"] = key
    print(json.dumps(result))


