def cmd_status(rpc, args):
    """Connection health check — reports full link state"""
    import sys
    try:
        result = rpc.call("getStatus")
    except RuntimeError as e:
        print(f"SHUNT: OFFLINE")
        print(f"  error: {e}")
        sys.exit(1)

    status = result if isinstance(result, dict) else {}
    print("SHUNT: CONNECTED")
    print(f"  native host: {status.get('nativeHost', '?')}")
    print(f"  group window: {status.get('groupWindowId', '?')}")
    print(f"  tab group:    {status.get('tabGroupId', '?')}")
    attached = status.get('attachedTabs', [])
    print(f"  attached ({len(attached)}): {attached or 'none'}")

    # Also show all user tabs
    try:
        tabs_res = rpc.call("getUserTabs")
        tabs = tabs_res.get('tabs', []) if isinstance(tabs_res, dict) else []
        print(f"  browser tabs ({len(tabs)}):")
        for t in tabs[:10]:
            url = str(t.get('url', ''))[:60]
            mark = " ◀ active" if t.get('active') else ""
            attached_mark = " [attached]" if t.get('id') in attached else ""
            print(f"    {t['id']} {url}{attached_mark}{mark}")
        if len(tabs) > 10:
            print(f"    ... ({len(tabs) - 10} more)")
    except RuntimeError:
        print("  (tabs: error fetching)")


