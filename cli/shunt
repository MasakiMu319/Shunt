#!/usr/bin/env python3
"""
Shunt CLI — browser automation client
JSON-RPC 2.0 over Unix socket to shunt-host → Extension
"""

import json
import socket
import sys
import os
import argparse
import select
import threading
import time

SOCKET_PATH = "/tmp/shunt.sock"

# ── JSON-RPC Client ──

class ShuntRPC:
    def __init__(self):
        self._id = 1
        self._sock = None

    def _connect(self):
        if self._sock:
            return self._sock
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(5)
        try:
            s.connect(SOCKET_PATH)
        except FileNotFoundError:
            raise RuntimeError(
                "Shunt not running. Is Helium open with Shunt extension loaded?\n"
                "  open -a Helium → chrome://extensions → Load Unpacked → .../Shunt/extension"
            )
        except ConnectionRefusedError:
            raise RuntimeError(
                "Shunt host refusing connections. Try reloading the extension.\n"
                "  chrome://extensions → Shunt → Reload"
            )
        self._sock = s
        return s

    def _close(self):
        if self._sock:
            try:
                self._sock.close()
            except:
                pass
            self._sock = None

    def call(self, method, params=None):
        """Send request and wait for matching response."""
        s = self._connect()
        req_id = self._id
        self._id += 1

        msg = {"jsonrpc": "2.0", "method": method, "id": req_id}
        if params is not None:
            msg["params"] = params

        s.sendall((json.dumps(msg) + "\n").encode())

        f = s.makefile("r")
        while True:
            line = f.readline()
            if not line:
                raise ConnectionError("Socket closed before response")
            resp = json.loads(line)
            if resp.get("id") == req_id:
                if "error" in resp:
                    err = resp["error"]
                    raise RuntimeError(f"[{err.get('code', '?')}] {err.get('message', 'unknown')}")
                return resp.get("result")

    def wait_for_event(self, tab_id, event_method, timeout=30):
        """Block until a cdpEvent notification matches tabId + method."""
        s = self._connect()
        f = s.makefile("r")
        s.settimeout(timeout)
        try:
            while True:
                line = f.readline()
                if not line:
                    raise ConnectionError("Socket closed")
                resp = json.loads(line)
                if resp.get("method") == "cdpEvent":
                    params = resp.get("params", {})
                    if params.get("tabId") == tab_id and params.get("method") == event_method:
                        return params.get("params", {})
        except socket.timeout:
            raise TimeoutError(f"Timeout waiting for {event_method} on tab {tab_id}")


# ── Heartbeat (daemon thread) ──

HEARTBEAT_INTERVAL = 30  # seconds

def _heartbeat_loop():
    """Send heartbeat notification to extension every HEARTBEAT_INTERVAL seconds."""
    while True:
        time.sleep(HEARTBEAT_INTERVAL)
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(3)
            s.connect(SOCKET_PATH)
            s.sendall(json.dumps({"jsonrpc": "2.0", "method": "heartbeat"}).encode() + b"\n")
            s.close()
        except Exception:
            pass  # silent — extension will timeout and clean up

_heartbeat_thread = threading.Thread(target=_heartbeat_loop, daemon=True)
_heartbeat_thread.start()


