#!/usr/bin/env python3
"""
Shunt CLI — browser automation client
JSON-RPC 2.0 over Unix socket to shunt-host → Extension
"""

import json
import socket
import sys
import os
import argparse
import select

SOCKET_PATH = "/tmp/shunt.sock"

# ── JSON-RPC Client ──

class ShuntRPC:
    def __init__(self):
        self._id = 1
        self._sock = None

    def _connect(self):
        if self._sock:
            return self._sock
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCKET_PATH)
        self._sock = s
        return s

    def _close(self):
        if self._sock:
            try:
                self._sock.close()
            except:
                pass
            self._sock = None

    def call(self, method, params=None):
        """Send request and wait for matching response."""
        s = self._connect()
        req_id = self._id
        self._id += 1

        msg = {"jsonrpc": "2.0", "method": method, "id": req_id}
        if params is not None:
            msg["params"] = params

        s.sendall((json.dumps(msg) + "\n").encode())

        f = s.makefile("r")
        while True:
            line = f.readline()
            if not line:
                raise ConnectionError("Socket closed before response")
            resp = json.loads(line)
            if resp.get("id") == req_id:
                if "error" in resp:
                    err = resp["error"]
                    raise RuntimeError(f"[{err.get('code', '?')}] {err.get('message', 'unknown')}")
                return resp.get("result")

    def wait_for_event(self, tab_id, event_method, timeout=30):
        """Block until a cdpEvent notification matches tabId + method."""
        s = self._connect()
        f = s.makefile("r")
        s.settimeout(timeout)
        try:
            while True:
                line = f.readline()
                if not line:
                    raise ConnectionError("Socket closed")
                resp = json.loads(line)
                if resp.get("method") == "cdpEvent":
                    params = resp.get("params", {})
                    if params.get("tabId") == tab_id and params.get("method") == event_method:
                        return params.get("params", {})
        except socket.timeout:
            raise TimeoutError(f"Timeout waiting for {event_method} on tab {tab_id}")


# ── CLI Commands ──

def cmd_create_tab(rpc, args):
    result = rpc.call("createTab")
    print(json.dumps(result))

def cmd_close_tab(rpc, args):
    result = rpc.call("closeTab", {"tabId": args.tab_id})
    print(json.dumps(result))

def cmd_attach(rpc, args):
    result = rpc.call("attach", {"tabId": args.tab_id})
    print(json.dumps(result))

def cmd_detach(rpc, args):
    result = rpc.call("detach", {"tabId": args.tab_id})
    print(json.dumps(result))

def cmd_cdp(rpc, args):
    cdp_params = None
    if args.params:
        try:
            cdp_params = json.loads(args.params)
        except json.JSONDecodeError:
            # Try as raw string (for simple values)
            cdp_params = args.params
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": args.method,
        "params": cdp_params,
    })
    print(json.dumps(result))

def cmd_screenshot(rpc, args):
    params = {"tabId": args.tab_id}
    if args.format:
        params["format"] = args.format
    if args.quality is not None:
        params["quality"] = args.quality
    if args.clip:
        params["clip"] = args.clip
    result = rpc.call("screenshot", params)
    # Output base64 data to stdout
    print(result.get("data", ""))

def cmd_click(rpc, args):
    """Click at viewport coordinates via JS dispatch (CDP Input.dispatchMouseEvent broken in Helium)"""
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const el = document.elementFromPoint({args.x}, {args.y});
                if (!el) return 'no-element at ({args.x},{args.y})';
                ['mousedown','mouseup','click','pointerdown','pointerup'].forEach(t => {{
                    el.dispatchEvent(new MouseEvent(t, {{ bubbles: true, cancelable: true, clientX: {args.x}, clientY: {args.y}, button: 0 }}));
                }});
                return 'clicked:' + el.tagName;
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["x"] = args.x
    result["y"] = args.y
    print(json.dumps(result))

def cmd_type(rpc, args):
    """Type text via JS dispatch (CDP Input.dispatchKeyEvent broken in Helium)"""
    escaped = args.text.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n")
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const text = '{escaped}';
                const el = document.activeElement;
                if (!el) return 'no-active-element';
                const tag = el.tagName.toLowerCase();
                if (tag === 'input' || tag === 'textarea') {{
                    const start = el.selectionStart ?? el.value.length;
                    el.value = el.value.slice(0, start) + text + el.value.slice(el.selectionEnd ?? start);
                    el.selectionStart = el.selectionEnd = start + text.length;
                    el.dispatchEvent(new Event('input', {{ bubbles: true }}));
                    el.dispatchEvent(new Event('change', {{ bubbles: true }}));
                    return 'typed:' + tag;
                }}
                if (el.isContentEditable) {{
                    el.focus();
                    document.execCommand('insertText', false, text);
                    return 'typed:contenteditable';
                }}
                return 'typed:unknown-' + tag;
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["text"] = args.text
    print(json.dumps(result))

def cmd_scroll(rpc, args):
    """Scroll via JS (CDP Input.dispatchMouseEvent wheel broken in Helium)"""
    result = rpc.call("executeCdp", {
        "tabId": args.tab_id,
        "method": "Runtime.evaluate",
        "params": {
            "expression": f"""
            (() => {{
                const before = [window.scrollX, window.scrollY];
                window.scrollBy({{ left: {args.dx}, top: {args.dy}, behavior: 'instant' }});
                const after = [window.scrollX, window.scrollY];
                return JSON.stringify({{ from: before, to: after, delta: [after[0]-before[0], after[1]-before[1]] }});
            }})()
            """,
            "returnByValue": True,
        },
    })
    result["deltaX"] = args.dx
    result["deltaY"] = args.dy
    print(json.dumps(result))

