    args = parser.parse_args()
    # Pre-process drag path: "100,200 300,400" → [(100,200),(300,400)]
    if args.command == "drag":
        pts = []
        for p in args.path.split():
            x, y = p.split(",")
            pts.append((int(x), int(y)))
        args.path = pts

    rpc = ShuntRPC()
    try:
        args.func(rpc, args)
    except RuntimeError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except ConnectionRefusedError:
        print("Error: Can't connect to shunt-host. Is the Extension loaded and running?", file=sys.stderr)
        sys.exit(1)
    finally:
