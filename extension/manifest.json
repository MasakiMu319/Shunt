{
  "name": "Shunt",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "Browser automation transport for Helium — three layers, zero coupling.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
